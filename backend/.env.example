# Local PostgreSQL (Homebrew postgresql@17)
# For Supabase / Render: use Project Settings → Database → Connection string (URI)
# Host looks like: db.xxxxx.supabase.co  (or the pooler host)
#
# Supabase pooler ports:
#   5432 = session mode (limited slots; easy to exhaust with multiple backends)
#   6543 = transaction mode (preferred for the Vapor API in local/dev)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=gapple
DATABASE_PASSWORD=
DATABASE_NAME=verra_dev
# Cap Fluent connections per event loop (default 1). Keep low on Supabase.
# DATABASE_MAX_CONNECTIONS_PER_EVENT_LOOP=1
# Optional override. Auto-enables TLS when host is not localhost.
# DATABASE_SSL=true

# Auth
JWT_SECRET=verra-local-dev-secret-change-me
APPLE_CLIENT_ID=app.rork.hiyjy25oz4yjrbssyotkw
ADMIN_SETUP_SECRET=verra-admin-setup-secret

# Seeded admin (development only by default; set SEED_ADMIN=true to force in other envs)
SEED_ADMIN=
SEED_ADMIN_EMAIL=admin@verra.test
SEED_ADMIN_PASSWORD=password123
SEED_ADMIN_NAME=Platform Admin

# Google OAuth (optional — for Continue with Google and Calendar sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URL on your Google Cloud *Web* OAuth client (http/https only):
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8080/api/calendar/google/oauth/callback
# iOS deep link — do not register this in Google Console; the backend bridges to it automatically.
# GOOGLE_CALENDAR_APP_CALLBACK_URI=app.rork.hiyjy25oz4yjrbssyotkw://google-calendar/callback

# Oura Ring OAuth (https://cloud.ouraring.com/oauth/applications)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=app.rork.hiyjy25oz4yjrbssyotkw://oura/callback

# Amazon SES (email delivery)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_SESSION_TOKEN=
SES_FROM_EMAIL=
SES_FROM_NAME=Verra
APP_URL=https://veera-app.onrender.com
PASSWORD_RESET_URL=https://veera-app.onrender.com/reset-password
# Optional — used by /join smart landing page when the app isn't installed
IOS_APP_STORE_ID=
IOS_APP_STORE_URL=

# Apple Push Notifications (APNs) — .p8 key from Apple Developer
APNS_KEY_ID=YOUR_KEY_ID
APNS_TEAM_ID=YOUR_TEAM_ID
APNS_BUNDLE_ID=app.rork.hiyjy25oz4yjrbssyotkw
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_PATH=
# Apple In-App Purchases
APPLE_IAP_SHARED_SECRET=
APPLE_IAP_USE_SANDBOX=true
# App Store Server Notifications v2 — set this URL in App Store Connect:
# https://your-api-domain/api/webhooks/app-store/notifications

# Twilio SMS
TWILIO_ACCOUNT_SID=ACa054e1fe514b20d873c1fec34fca3699
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# S3 object storage (optional — falls back to local uploads/ if unset or upload fails)
# Set all three for S3; leave S3_BUCKET empty to force local disk storage.
# Directory buckets (S3 Express) look like: verra-app--use1-az4--x-s3
S3_BUCKET=
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION above are reused for S3.

# Stripe (card + Apple Pay via Payment Sheet)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Apple Pay merchant ID — register in Apple Developer and Stripe Dashboard
APPLE_PAY_MERCHANT_ID=merchant.com.verraapp.ios
STRIPE_MERCHANT_COUNTRY=US
STRIPE_CURRENCY=usd
STRIPE_TRAINER_MONTHLY_AMOUNT=600
STRIPE_TRAINER_ANNUAL_AMOUNT=5760
# Stripe webhook URL: https://your-api-domain/api/webhooks/stripe

# Giphy (GIF picker in chat). Optional — falls back to Giphy public beta key for local/dev.
GIPHY_API_KEY=
